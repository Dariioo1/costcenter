<mvc:View
    controllerName="costescenter.controller.CostCenter"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:t="sap.ui.table">

    <Page title="Centro Beneficios" showHeader="false">

        <content>

            <VBox>

                <!-- Filtros -->
                <Toolbar>

                    <Label text="Centro Beneficios:"/>

                    <SearchField
                        width="250px"
                        placeholder=" "
                        liveChange=".onFilterName"/>

                 <!--   <Label
                        text="Budget:"
                      class="sapUiMediumMarginBegin"/> 

                    <SearchField
                        width="200px"
                                                placeholder=" "

                        liveChange=".onFilterBudget"/>-->

                </Toolbar>

                <!-- Contador -->
                <Toolbar>
                    <Title id="titleCount" text="Centro Beneficios (0)"/>
                </Toolbar>

                <!-- TreeTable -->
<t:TreeTable
    id="treeTable"
    rows="{path:'/nodes', parameters:{arrayNames:['nodes']}}"
    visibleRowCount="50"
    selectionMode="None"
    width="100%">

                    <t:columns>

                     <t:Column
    width="700px"
    sortProperty="name"
    filterProperty="name">

    <Label text="Nombre"/>

    <t:template>

        <HBox alignItems="Center">

            <CheckBox
                selected="{selected}"
                select=".onSelectNode"/>

            <Text
                text="{name}"
                class="sapUiTinyMarginBegin"/>

        </HBox>

    </t:template>

</t:Column>

                   <!--  <t:Column
                            width="200px"
                            sortProperty="budget"
                            filterProperty="budget"
                            hAlign="End">

                            <Label text="Budget"/>

                            <t:template>
                                <Text text="{budget}"/>
                            </t:template>

                        </t:Column> -->

                    </t:columns>

                </t:TreeTable>

            </VBox>

        </content>

    </Page>

</mvc:View>